# Copy to config.yml and supply private deployment values.
app:
  settings: src.settings.config.CoreSettings
  tables_path: infra.pg.tables
  modules: [src.apps.core, src.apps.shop, src.apps.network]
run:
  entrypoint: src.entrypoints.api:app
  backend: uvicorn
  host: 127.0.0.1
  port: 8000
  reload: false
fastapi:
  title: PapilioVPN Core API
  description: The central management API for PapilioVPN
  version: 0.0.0
db:
  dsn: postgresql+asyncpg://papiliovpn:change-me@127.0.0.1:5432/papiliovpn
  test_dsn: postgresql+asyncpg://papiliovpn:change-me@127.0.0.1:5432/papiliovpn_test
  pool_timeout: 5
  pool_recycle: 1800
  pool_size: 5
  # The Outbox relay uses two connections per configured publication.
  max_overflow: 10
crypto:
  encryption_key: replace-with-private-encryption-key
  password_salt: null
jwt:
  algorithm: HS256
  secret_key: null
  api_secret: replace-with-private-api-secret
  access_token_expire_minutes: 15
  refresh_token_expire_minutes: 20160
# USD crypto pricing reads its latest rate from Redis.
redis: null
# Live Node host stats use the registered ID and the same management endpoint.
# Enable management TLS and set the matching management.api_key on Node.
# Set the API key only in private deployment settings.
# node_host:
#   timeout_seconds: 3
#   checks:
#     interval_seconds: 60  # Set to null to disable scheduled checks.
#     stale_after_seconds: 180
#     batch_size: 32
#     concurrency: 8
#   targets:
#     1:
#       address: node.example.com
#       port: 8081
#       api_key: replace-with-private-node-key
#       # ca_pem: |  # Optional private CA PEM. Otherwise use default trust.
# Configure hosted gateway accounts through the Shop admin API.
cli:
  color: true
  theme:
    title: bold cyan
    accent: cyan
    success: bold green
    error: bold red
# Enable NATS for the optional Scheduler and Events processes.
# nats:
#   servers: [nats://127.0.0.1:4222]
# The USD rate refreshes every 20 seconds by default.
# Both scheduled and manual refreshes use the jobs worker and Redis.
# Set the interval to null to disable automatic refresh.
# scheduler:
#   rate_refresh_interval: 20
storage:
  path: var/media
  temp_dir: var/tmp
  # Public server/CDN root serving path/digest-prefix/digest.
  # Configure before uploading; this setting does not start a file server.
  # public_base_url: https://media.example.org/files/
  max_file_size: 5242880
  allowed_extensions: []
logging:
  level: INFO
  format: console
  service: papiliovpn-core-api
